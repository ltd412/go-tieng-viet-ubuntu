#!/usr/bin/python3
"""Tells the user when a newer GTV release exists and installs it on request.

    gtv-update check      # run daily by the systemd user timer: one HTTPS request, then exits
    gtv-update status     # one JSON line: installed and latest version (settings window)
    gtv-update install [--password-stdin]
                          # download the newest .deb, verify its sha256, install it with sudo
                          # (password on stdin) or pkexec; prints PROGRESS/DONE/ERROR lines
    gtv-update --version

Nothing stays resident. The check asks GitHub for the latest release, compares it with the
installed engine and, when newer, shows a desktop notification once per version. Installing is
always the user's choice (the Update button in the settings window, or `gtv-update install`);
root comes from sudo (password typed in the settings window, never stored) or pkexec. `check_updates = false` in config.toml turns the
check off.
"""
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
import urllib.request

REPO = os.environ.get("GTV_UPDATE_REPO", "ltd412/go-tieng-viet-ubuntu")
API = os.environ.get("GTV_UPDATE_API", f"https://api.github.com/repos/{REPO}/releases/latest")
ENGINE = os.environ.get("GTV_ENGINE", "/usr/lib/ibus-gtv/ibus-engine-gtv")
SETUP = os.environ.get("GTV_SETUP", "/usr/lib/ibus-gtv/ibus-setup-gtv")
TIMEOUT = 15
ACTION_WAIT = 120


def say(msg):
    print(f"gtv-update: {msg}", flush=True)


def config_dir():
    return os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "gtv")


def state_path():
    base = os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache"))
    return os.path.join(base, "gtv", "update.json")


def enabled():
    try:
        import tomllib
        with open(os.path.join(config_dir(), "config.toml"), "rb") as f:
            return tomllib.load(f).get("check_updates", True) is not False
    except Exception:
        return True


def version_tuple(text):
    parts = []
    for p in text.lstrip("v").split("."):
        digits = "".join(c for c in p if c.isdigit())
        if not digits:
            break
        parts.append(int(digits))
    return tuple(parts)


def installed_version():
    out = subprocess.run([ENGINE, "--version"], capture_output=True, text=True, timeout=10).stdout
    return out.split()[-1]


def latest_release():
    req = urllib.request.Request(API, headers={"Accept": "application/vnd.github+json",
                                               "User-Agent": "gtv-update"})
    with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
        rel = json.load(r)
    for a in rel.get("assets", []):
        if a["name"].endswith(".deb"):
            digest = (a.get("digest") or "").removeprefix("sha256:")
            return {"version": rel["tag_name"].lstrip("v"), "url": a["browser_download_url"],
                    "name": a["name"], "sha256": digest, "page": rel.get("html_url", "")}
    return None


def newer():
    """The latest release when it is newer than what is installed, else None."""
    rel = latest_release()
    if rel and version_tuple(rel["version"]) > version_tuple(installed_version()):
        return rel
    return None


def notified_version():
    try:
        with open(state_path()) as f:
            return json.load(f).get("notified", "")
    except Exception:
        return ""


def remember(version):
    os.makedirs(os.path.dirname(state_path()), exist_ok=True)
    with open(state_path(), "w") as f:
        json.dump({"notified": version}, f)


def classify_sudo(err):
    if any(m in err.lower() for m in ("incorrect password", "try again", "authentication failure")):
        return "wrong-password"
    if any(m in err.lower() for m in ("password is required", "no password was provided",
                                      "a terminal is required")):
        return "need-password"
    return "failed"


def trusted(url):
    return url.startswith(f"https://github.com/{REPO}/releases/download/") or url.startswith(
        "http://127.0.0.1:")


def download(rel, progress):
    """Downloads the .deb into the cache dir and verifies its sha256; returns the path."""
    if not trusted(rel["url"]):
        raise RuntimeError("địa chỉ tải không đáng tin")
    if not rel["sha256"]:
        raise RuntimeError("bản phát hành không có mã sha256 để kiểm tra")
    folder = os.path.join(os.path.dirname(state_path()), "update")
    os.makedirs(folder, exist_ok=True)
    os.chmod(folder, 0o755)
    path = os.path.join(folder, rel["name"])
    h = hashlib.sha256()
    with urllib.request.urlopen(urllib.request.Request(rel["url"], headers={"User-Agent": "gtv-update"}),
                                timeout=60) as r, open(path, "wb") as f:
        total = int(r.headers.get("Content-Length") or 0)
        got = last = 0
        while chunk := r.read(1 << 16):
            h.update(chunk)
            f.write(chunk)
            got += len(chunk)
            if total and got * 100 // total >= last + 5:
                last = got * 100 // total
                progress(min(99, last))
    if h.hexdigest() != rel["sha256"]:
        os.remove(path)
        raise RuntimeError("file tải về không khớp mã sha256 của bản phát hành")
    os.chmod(path, 0o644)
    return path


def run(cmd, stdin=None):
    p = subprocess.run(cmd, input=stdin, capture_output=True, text=True,
                       env={**os.environ, "LC_ALL": "C", "LANG": "C"})
    return p.returncode, p.stderr


def install_deb(path, password):
    """sudo without a prompt, else sudo with the password, else pkexec when sudo is absent."""
    cmd = ["dpkg", "-i", path]
    if shutil.which("sudo"):
        if password is None:
            code, err = run(["sudo", "-n", *cmd])
            if code == 0:
                return "ok"
            return "need-password" if classify_sudo(err) == "need-password" else f"failed: {err.strip()[-300:]}"
        code, err = run(["sudo", "-S", "-p", "", *cmd], password + "\n")
        if code == 0:
            return "ok"
        kind = classify_sudo(err)
        return kind if kind == "wrong-password" else f"failed: {err.strip()[-300:]}"
    code, err = run(["pkexec", *cmd])
    if code == 0:
        return "ok"
    return "failed: đã hủy hoặc pkexec không chạy được" if code in (126, 127) else f"failed: dpkg exit {code}"


def cmd_status():
    """One JSON line for the settings window."""
    cur = installed_version()
    try:
        rel = latest_release()
    except Exception as e:
        print(json.dumps({"current": cur, "error": str(e)}))
        return 0
    avail = bool(rel and version_tuple(rel["version"]) > version_tuple(cur))
    print(json.dumps({"current": cur, "latest": rel["version"] if rel else cur, "available": avail,
                      "page": rel["page"] if rel else ""}))
    return 0


def cmd_install(use_stdin):
    """Prints PROGRESS n / NEED_PASSWORD / WRONG_PASSWORD / ERROR msg / DONE, one per line."""
    password = sys.stdin.readline().rstrip("\n") if use_stdin else None
    try:
        rel = newer()
        if not rel:
            print("DONE", flush=True)
            return 0
        path = download(rel, lambda n: print(f"PROGRESS {n}", flush=True))
        print("INSTALLING", flush=True)
        result = install_deb(path, password)
    except Exception as e:
        print(f"ERROR {e}", flush=True)
        return 1
    if result == "ok":
        shutil.rmtree(os.path.dirname(path), ignore_errors=True)
        print("DONE", flush=True)
        return 0
    if result == "need-password":
        print("NEED_PASSWORD", flush=True)
        return 10
    if result == "wrong-password":
        print("WRONG_PASSWORD", flush=True)
        return 10
    print("ERROR " + result.removeprefix("failed: "), flush=True)
    return 1


def notify(rel):
    """Shows the notification; returns True when the user pressed the update button."""
    cmd = ["notify-send", "--app-name=Gõ Tiếng Việt", "--icon=input-keyboard",
           "--action=update=Mở trang cập nhật", "--wait", f"--expire-time={ACTION_WAIT * 1000}",
           f"Có bản GTV mới: {rel['version']}",
           "Mở cửa sổ cài đặt Gõ Tiếng Việt để cập nhật."]
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=ACTION_WAIT + 10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return False
    return out.strip() == "update"


def check():
    if not enabled():
        return 0
    try:
        rel = newer()
    except Exception as e:  # offline, rate limited, GitHub down: try again tomorrow
        say(f"không kiểm tra được: {e}")
        return 0
    if not rel or notified_version() == rel["version"]:
        return 0
    remember(rel["version"])
    if notify(rel):
        subprocess.Popen([SETUP, "--update"], start_new_session=True)
    return 0


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "check"
    if cmd == "--version":
        print("gtv-update 1")
        return 0
    if cmd == "check":
        return check()
    if cmd == "status":
        return cmd_status()
    if cmd == "install":
        return cmd_install("--password-stdin" in sys.argv)
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main())
