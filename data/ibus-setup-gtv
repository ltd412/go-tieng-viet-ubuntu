#!/usr/bin/python3
"""Preferences for GTV: edits ~/.config/gtv/config.toml. The engine reloads the file by itself,
so every change is saved at once and takes effect the next time a text field gets focus."""
import json
import os
import subprocess
import sys
import threading
import tomllib

PATH = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "gtv", "config.toml")

UPDATER = os.path.join(os.path.dirname(os.path.realpath(__file__)), "gtv-update")

MODES = ["backspace", "off", "preedit", "surrounding", "select", "forward-keys"]
SHORT = {
    "backspace": "Tiếng Việt",
    "off": "Tắt – chỉ gõ tiếng Anh",
    "preedit": "Tiếng Việt, có gạch chân",
    "surrounding": "Tiếng Việt (surrounding)",
    "select": "Tiếng Việt (select, thử nghiệm)",
    "forward-keys": "Tiếng Việt (forward-keys, thử nghiệm)",
}
MODE_HELP = {
    "backspace": "Mặc định. Đúng ở GTK, terminal, Chrome, VS Code.",
    "off": "Mọi phím đi thẳng vào app, không biến đổi gì.",
    "preedit": "Chữ đang gõ có gạch chân. Dùng khi một app bị lỗi với chế độ mặc định.",
    "surrounding": "Chỉ các app GTK/Qt hỗ trợ tốt.",
    "select": "Thử nghiệm.",
    "forward-keys": "Thử nghiệm.",
}
TONE_STYLES = ["modern", "old"]
TONE_LABELS = ["Kiểu mới: hòa, khỏe, thủy", "Kiểu cũ: hoà, khoẻ, thuỷ"]
TERMINALS = ["gnome-terminal", "kitty", "alacritty", "xterm", "konsole", "tilix", "terminator",
             "warp", "wezterm", "xfce4-terminal"]

DEFAULTS = {
    "tone_style": "modern",
    "free_marking": True,
    "w_to_u": True,
    "spell_check": True,
    "pause_ms": 30,
    "preedit_underline": False,
    "default_mode": "backspace",
    "apps": {},
}
# Keys the window has no control for; kept as they are so saving never drops them.
UPDATE_MODE = "--update" in sys.argv
PASSTHROUGH = ["address_bar_mode", "check_updates"]


def load():
    cfg = {**DEFAULTS, "apps": {}}
    try:
        with open(PATH, "rb") as f:
            raw = tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError):
        return cfg
    for k in [*DEFAULTS, *PASSTHROUGH]:
        if k in raw:
            cfg[k] = raw[k]
    cfg["apps"] = {str(k): str(v) for k, v in raw.get("apps", {}).items()}
    return cfg


def q(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def save(cfg):
    lines = [
        "# Tạo bởi ibus-setup-gtv. Engine tự nạp lại khi file đổi.",
        f"tone_style = {q(cfg['tone_style'])}",
        f"free_marking = {str(cfg['free_marking']).lower()}",
        f"w_to_u = {str(cfg['w_to_u']).lower()}",
        f"spell_check = {str(cfg['spell_check']).lower()}",
        f"pause_ms = {int(cfg['pause_ms'])}",
        f"preedit_underline = {str(cfg['preedit_underline']).lower()}",
        f"default_mode = {q(cfg['default_mode'])}",
    ]
    lines += [
        f"{k} = {str(cfg[k]).lower() if isinstance(cfg[k], bool) else q(str(cfg[k]))}"
        for k in PASSTHROUGH
        if k in cfg
    ]
    lines += [
        "",
        "[apps]",
    ]
    lines += [f"{q(k)} = {q(v)}" for k, v in cfg["apps"].items() if k]
    os.makedirs(os.path.dirname(PATH), exist_ok=True)
    tmp = PATH + ".tmp"
    with open(tmp, "w") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(tmp, PATH)


def wm_class_of_clicked_window():
    """Runs xprop and returns the class part of WM_CLASS of the window the user clicks."""
    out = subprocess.run(["xprop", "WM_CLASS"], capture_output=True, text=True, timeout=15).stdout
    parts = [p.strip().strip('"').lower() for p in out.partition("=")[2].split(",") if p.strip()]
    return parts[-1] if parts else None


def main():
    import gi

    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, GLib, Gtk

    class Prefs(Adw.PreferencesWindow):
        def __init__(self, app):
            super().__init__(application=app, title="Gõ Tiếng Việt")
            self.set_default_size(680, 720)
            self.cfg = load()
            self.app_rows = []
            self.save_id = 0

            general = Adw.PreferencesPage(title="Chung", icon_name="preferences-system-symbolic")
            self.add(general)

            typing = Adw.PreferencesGroup(
                title="Kiểu gõ",
                description="Telex hay VNI chọn ở Settings → Keyboard → Input Sources "
                            "(thêm Vietnamese Telex hoặc Vietnamese VNI).")
            general.add(typing)

            self.tone = Adw.ComboRow(title="Vị trí dấu", model=Gtk.StringList.new(TONE_LABELS))
            self.tone.set_selected(TONE_STYLES.index(self.cfg["tone_style"])
                                   if self.cfg["tone_style"] in TONE_STYLES else 0)
            self.tone.connect("notify::selected", lambda r, _p: self.set(
                "tone_style", TONE_STYLES[r.get_selected()]))
            typing.add(self.tone)

            self.free = Adw.SwitchRow(
                title="Gõ dấu tự do",
                subtitle="Cho phép dấu mũ, móc đặt sau phụ âm cuối: tieengs → tiếng, viete → viêt.",
                active=bool(self.cfg["free_marking"]))
            self.free.connect("notify::active", lambda r, _p: self.set("free_marking", r.get_active()))
            typing.add(self.free)

            self.wtu = Adw.SwitchRow(
                title="Gõ w thành ư",
                subtitle="Telex: w đứng một mình hoặc sau phụ âm ra ư (w → ư, nw → nư). "
                         "Tắt nếu bạn gõ nhiều chữ w tiếng Anh; uw, ow, aw vẫn ra ư, ơ, ă.",
                active=bool(self.cfg["w_to_u"]))
            self.wtu.connect("notify::active", lambda r, _p: self.set("w_to_u", r.get_active()))
            typing.add(self.wtu)

            self.spell = Adw.SwitchRow(
                title="Kiểm tra chính tả",
                subtitle="Từ không phải âm tiết tiếng Việt (class, windows…) giữ nguyên phím đã gõ.",
                active=bool(self.cfg["spell_check"]))
            self.spell.connect("notify::active", lambda r, _p: self.set("spell_check", r.get_active()))
            typing.add(self.spell)

            delivery = Adw.PreferencesGroup(
                title="Cách gửi chữ vào ứng dụng",
                description="Chỉ đổi khi có app bị lỗi mất chữ hoặc đảo chữ.")
            general.add(delivery)

            self.mode = Adw.ComboRow(
                title="Mặc định cho mọi app",
                model=Gtk.StringList.new([SHORT[m] for m in MODES]))
            self.mode.set_selected(MODES.index(self.cfg["default_mode"])
                                   if self.cfg["default_mode"] in MODES else 0)
            self.mode.connect("notify::selected", self.on_default_mode)
            self.on_default_mode(self.mode, None, save_now=False)
            delivery.add(self.mode)

            self.pause = Adw.SpinRow.new_with_range(0, 100, 1)
            self.pause.set_title("Độ trễ sau BackSpace (ms)")
            self.pause.set_subtitle("Tăng lên 40–60 nếu app chậm và thỉnh thoảng bị đảo hoặc mất chữ.")
            self.pause.set_value(float(self.cfg["pause_ms"]))
            self.pause.connect("notify::value", lambda r, _p: self.set("pause_ms", int(r.get_value())))
            delivery.add(self.pause)

            self.underline = Adw.SwitchRow(
                title="Gạch chân ở chế độ preedit",
                subtitle="Chrome và app Electron luôn gạch chân, bất kể cài đặt này.",
                active=bool(self.cfg["preedit_underline"]))
            self.underline.connect("notify::active", lambda r, _p: self.set(
                "preedit_underline", r.get_active()))
            delivery.add(self.underline)

            apps_page = Adw.PreferencesPage(title="Ứng dụng", icon_name="view-list-symbolic")
            self.add(apps_page)
            self.apps_group = Adw.PreferencesGroup(
                title="Cài đặt riêng cho từng ứng dụng",
                description="Ví dụ tắt tiếng Việt trong terminal để gõ lệnh không bị đổi chữ.")
            apps_page.add(self.apps_group)

            actions = Adw.PreferencesGroup()
            apps_page.add(actions)
            for label, cb in [("Chọn ứng dụng bằng cách bấm vào cửa sổ của nó", self.pick),
                              ("Thêm các terminal phổ biến (tắt tiếng Việt)", self.add_terminals),
                              ("Thêm ứng dụng theo tên…", self.add_by_name)]:
                row = Adw.ActionRow(title=label, activatable=True)
                row.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
                row.connect("activated", cb)
                actions.add(row)
            self.build_update_page(Adw, Gtk)
            self.refresh_apps()
            if UPDATE_MODE:
                self.set_visible_page(self.update_page)
            if UPDATE_MODE or self.cfg.get("check_updates", True) is not False:
                self.check_update()

        # ---- updates ----
        def build_update_page(self, Adw, Gtk):
            self.update_page = Adw.PreferencesPage(title="Cập nhật", icon_name="software-update-available-symbolic")
            self.add(self.update_page)
            group = Adw.PreferencesGroup(
                title="Cập nhật",
                description="Tải bản mới từ GitHub Releases, kiểm tra mã sha256 rồi cài bằng sudo. "
                            "Cài xong IBus tự khởi động lại.")
            self.update_page.add(group)
            self.ver_row = Adw.ActionRow(title="Phiên bản đang dùng", subtitle="…")
            group.add(self.ver_row)
            self.latest_row = Adw.ActionRow(title="Bản mới nhất", subtitle="Chưa kiểm tra")
            self.check_btn = Gtk.Button(label="Kiểm tra", valign=Gtk.Align.CENTER)
            self.check_btn.connect("clicked", lambda *_: self.check_update())
            self.latest_row.add_suffix(self.check_btn)
            self.update_btn = Gtk.Button(label="Cập nhật", valign=Gtk.Align.CENTER, visible=False)
            self.update_btn.add_css_class("suggested-action")
            self.update_btn.connect("clicked", lambda *_: self.start_install())
            self.latest_row.add_suffix(self.update_btn)
            group.add(self.latest_row)
            self.progress = Gtk.ProgressBar(visible=False, margin_top=8)
            group.add(self.progress)

            options = Adw.PreferencesGroup()
            self.update_page.add(options)
            self.auto = Adw.SwitchRow(
                title="Tự kiểm tra bản mới",
                subtitle="Mỗi ngày một lần, hiện thông báo khi có bản mới. Không có tiến trình nào chạy nền.",
                active=self.cfg.get("check_updates", True) is not False)
            self.auto.connect("notify::active", lambda r, _p: self.set("check_updates", r.get_active()))
            options.add(self.auto)

        def updater(self, *args, stdin=None):
            return subprocess.Popen([UPDATER, *args], stdin=subprocess.PIPE if stdin is not None else None,
                                    stdout=subprocess.PIPE, text=True)

        def check_update(self):
            self.check_btn.set_sensitive(False)
            self.latest_row.set_subtitle("Đang kiểm tra…")

            def work():
                try:
                    out = self.updater("status").communicate(timeout=30)[0]
                    info = json.loads(out.strip().splitlines()[-1])
                except Exception as e:
                    info = {"error": str(e)}
                GLib.idle_add(self.on_status, info)

            threading.Thread(target=work, daemon=True).start()

        def on_status(self, info):
            self.check_btn.set_sensitive(True)
            if info.get("current"):
                self.ver_row.set_subtitle(info["current"])
            if info.get("error"):
                self.latest_row.set_subtitle(f"Không kiểm tra được: {info['error']}")
            elif info.get("available"):
                self.latest_row.set_subtitle(f"Có bản mới: {info['latest']}")
                self.update_btn.set_label(f"Cập nhật lên {info['latest']}")
                self.update_btn.set_visible(True)
            else:
                self.latest_row.set_subtitle("Bạn đang dùng bản mới nhất")
                self.update_btn.set_visible(False)
            return False

        def start_install(self, password=None, wrong=False):
            self.update_btn.set_sensitive(False)
            self.check_btn.set_sensitive(False)
            self.progress.set_visible(True)
            self.progress.set_fraction(0)
            self.latest_row.set_subtitle("Đang tải…")

            def work():
                args = ["install"] + (["--password-stdin"] if password is not None else [])
                proc = self.updater(*args, stdin=password)
                if password is not None:
                    proc.stdin.write(password + "\n")
                    proc.stdin.close()
                last = ""
                for line in proc.stdout:
                    last = line.strip()
                    GLib.idle_add(self.on_install_line, last)
                proc.wait()
                if not last:
                    GLib.idle_add(self.on_install_line, "ERROR gtv-update không chạy được")

            threading.Thread(target=work, daemon=True).start()

        def on_install_line(self, line):
            word, _, rest = line.partition(" ")
            if word == "PROGRESS":
                self.progress.set_fraction(int(rest) / 100)
            elif word == "INSTALLING":
                self.progress.pulse()
                self.latest_row.set_subtitle("Đang cài đặt…")
            elif word in ("NEED_PASSWORD", "WRONG_PASSWORD"):
                self.install_stopped()
                self.ask_password(word == "WRONG_PASSWORD")
            elif word == "ERROR":
                self.install_stopped()
                self.latest_row.set_subtitle(f"Cập nhật lỗi: {rest}")
                self.update_btn.set_visible(True)
            elif word == "DONE":
                self.latest_row.set_subtitle("Đã cập nhật, đang mở lại cửa sổ…")
                subprocess.Popen(["/bin/sh", "-c", 'sleep 2; exec "$0" --update', sys.argv[0]],
                                 start_new_session=True)
                self.get_application().quit()
            return False

        def install_stopped(self):
            self.progress.set_visible(False)
            self.update_btn.set_sensitive(True)
            self.check_btn.set_sensitive(True)

        def ask_password(self, wrong):
            from gi.repository import Adw, Gtk
            entry = Gtk.PasswordEntry(show_peek_icon=True, activates_default=True)
            dialog = Adw.MessageDialog(
                transient_for=self, heading="Cần quyền quản trị",
                body=("Mật khẩu không đúng, nhập lại. " if wrong else "") +
                     "Nhập mật khẩu sudo để cài bản mới. Mật khẩu chỉ gửi cho sudo, không được lưu.")
            dialog.set_extra_child(entry)
            dialog.add_response("cancel", "Hủy")
            dialog.add_response("ok", "Cài đặt")
            dialog.set_response_appearance("ok", Adw.ResponseAppearance.SUGGESTED)
            dialog.set_default_response("ok")
            dialog.connect("response", lambda _d, r: r == "ok" and self.start_install(entry.get_text()))
            dialog.present()

        # ---- state ----
        def set(self, key, value):
            self.cfg[key] = value
            self.queue_save()

        def queue_save(self):
            if self.save_id:
                GLib.source_remove(self.save_id)
            self.save_id = GLib.timeout_add(300, self.flush)

        def flush(self):
            self.save_id = 0
            try:
                save(self.cfg)
                self.add_toast(Adw.Toast(title="Đã lưu", timeout=1))
            except OSError as e:
                self.add_toast(Adw.Toast(title=f"Không lưu được: {e}"))
            return False

        def on_default_mode(self, row, _p, save_now=True):
            mode = MODES[row.get_selected()]
            row.set_subtitle(MODE_HELP[mode])
            if save_now:
                self.set("default_mode", mode)

        # ---- per-app list ----
        def refresh_apps(self):
            for r in self.app_rows:
                self.apps_group.remove(r)
            self.app_rows = []
            if not self.cfg["apps"]:
                empty = Adw.ActionRow(
                    title="Chưa có ứng dụng nào",
                    subtitle="Mọi ứng dụng dùng cách gửi chữ mặc định ở trang Chung.")
                empty.set_sensitive(False)
                self.apps_group.add(empty)
                self.app_rows.append(empty)
                return
            for name, mode in sorted(self.cfg["apps"].items()):
                row = Adw.ComboRow(title=name, model=Gtk.StringList.new([SHORT[m] for m in MODES]))
                row.set_selected(MODES.index(mode) if mode in MODES else 0)
                row.connect("notify::selected", self.on_app_mode, name)
                remove = Gtk.Button(icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER,
                                    tooltip_text="Xóa khỏi danh sách")
                remove.add_css_class("flat")
                remove.connect("clicked", self.on_remove, name)
                row.add_suffix(remove)
                self.apps_group.add(row)
                self.app_rows.append(row)

        def on_app_mode(self, row, _p, name):
            self.cfg["apps"][name] = MODES[row.get_selected()]
            self.queue_save()

        def on_remove(self, _b, name):
            self.cfg["apps"].pop(name, None)
            self.queue_save()
            self.refresh_apps()

        def upsert(self, name, mode="off"):
            name = name.strip().lower()
            if name:
                self.cfg["apps"][name] = mode
                self.queue_save()
                self.refresh_apps()

        def add_terminals(self, *_):
            for t in TERMINALS:
                self.upsert(t)
            self.add_toast(Adw.Toast(title="Đã thêm các terminal, tiếng Việt tắt"))

        def pick(self, *_):
            self.add_toast(Adw.Toast(title="Bấm vào cửa sổ của ứng dụng cần thêm…", timeout=4))

            def work():
                try:
                    name = wm_class_of_clicked_window()
                except (OSError, subprocess.TimeoutExpired):
                    name = None
                GLib.idle_add(self.picked, name)

            threading.Thread(target=work, daemon=True).start()

        def picked(self, name):
            if name:
                self.upsert(name)
                self.add_toast(Adw.Toast(title=f"Đã thêm “{name}”, tiếng Việt tắt"))
            else:
                self.add_toast(Adw.Toast(title="Không lấy được tên cửa sổ (cần X11 và xprop)"))
            return False

        def add_by_name(self, *_):
            entry = Gtk.Entry(placeholder_text="ví dụ: gnome-terminal", activates_default=True)
            dialog = Adw.MessageDialog(
                transient_for=self, heading="Thêm ứng dụng",
                body="Nhập một phần của WM_CLASS (xem bằng `xprop WM_CLASS`).")
            dialog.set_extra_child(entry)
            dialog.add_response("cancel", "Hủy")
            dialog.add_response("add", "Thêm")
            dialog.set_response_appearance("add", Adw.ResponseAppearance.SUGGESTED)
            dialog.set_default_response("add")
            dialog.connect("response", lambda _d, r: r == "add" and self.upsert(entry.get_text()))
            dialog.present()

    class App(Adw.Application):
        def __init__(self):
            super().__init__(application_id="org.freedesktop.IBus.GTV.Setup")
            self.connect("activate", lambda a: Prefs(a).present())

    return App().run([sys.argv[0]])


if __name__ == "__main__":
    if "--selftest" in sys.argv:
        save({**DEFAULTS, "tone_style": "old", "pause_ms": 20, "apps": {"foo": "off"}})
        print(load())
        sys.exit(0)
    try:
        sys.exit(main())
    except (ImportError, ValueError) as e:
        sys.exit(f"ibus-setup-gtv cần gói gir1.2-adw-1 và gir1.2-gtk-4.0 ({e}).\n"
                 f"Có thể sửa tay file {PATH}.")
